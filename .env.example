# AssemblyAI Voice Agent API Key
ASSEMBLYAI_API_KEY=

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easyledger
EASYLEDGER_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres

# Server configuration
PORT=3000
HOST=0.0.0.0

# `npm run start:dev` opts into this seeded owner for local browser testing.
# The API only accepts it from loopback requests in development mode.
# Set EASYLEDGER_LOCAL_DEMO_DISABLED=true to turn it off for a dev run.
EASYLEDGER_LOCAL_DEMO_DISABLED=false
