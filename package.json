{
  "name": "easyledger-documentation",
  "private": true,
  "version": "0.1.0",
  "description": "EasyLedger documentation plus the implemented Day 20 data foundation, Day 21 mutation service, and Day 22 manual API.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/server.ts",
    "start:dev": "node --env-file-if-exists=.env --import ./scripts/local-development-env.mjs apps/api/server.ts",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:domain && npm run test:api",
    "docs:sync": "node scripts/sync-docs.cjs",
    "docs:check": "node scripts/sync-docs.cjs --check",
    "docs:watch": "node scripts/watch-docs.cjs",
    "graph:query": "graphify query",
    "graph:serve": "node scripts/serve-graph.cjs",
    "security:scan": "node scripts/scan-bundle-security.mjs",
    "audit:a11y": "node scripts/audit-accessibility.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "rehearsal:backup": "node scripts/backup-restore-rehearsal.mjs",
    "test:web": "node --test tests/web/*.test.mjs",
    "test:domain": "node --test tests/domain/*.test.mjs",
    "test:database:day21": "node --test tests/database/day21_integration.mjs",
    "test:database:rehearsal": "node --test tests/database/backup-restore-rehearsal.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:database:day22": "node --test tests/database/day22_integration.mjs",
    "test:database:day23": "node --test tests/database/day23_integration.mjs"
  },
  "devDependencies": {
    "@sentropic/graphify": "0.18.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.16.3"
  }
}
